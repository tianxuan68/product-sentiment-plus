# 本地 MySQL（将 YOUR_PASSWORD 改为实际密码，@ 需编码为 %40）
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/jeecg-boot?charset=utf8mb4

# 本地开发：复制 .env.local.example 为 .env.local，可覆盖上方 DATABASE_URL 及 CORS 等
# copy .env.local.example .env.local

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=60
DB_WRITE_TIMEOUT=60
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY=1
DB_SESSION_PING=false
DB_WARMUP_ENABLED=false
DB_WARMUP_CONNECTIONS=1
DB_BACKGROUND_CONNECT=true
AUTH_CACHE_TTL_SECONDS=300
DICT_CACHE_TTL_SECONDS=600
PERMISSION_CACHE_TTL_SECONDS=600
USER_ROLES_CACHE_TTL_SECONDS=600

JWT_EXPIRE_HOURS=84
ENABLE_LOGIN_CAPTCHA=false
SIGNATURE_SECRET=dd05f1c54d63749eda95f9fa6d49v442a

THIRD_LOGIN_BASE_URL=http://localhost:8000/jeecg-boot
